<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.aulait.qaa</groupId>
    <artifactId>quarkus-auth-adapter</artifactId>
    <version>0.8-SNAPSHOT</version>
    <relativePath>../</relativePath>
  </parent>

  <artifactId>quarkus-auth-adapter-refimpl</artifactId>
  <packaging>pom</packaging>

  <properties>
    <auth.user>admin</auth.user>
    <auth.password>admin</auth.password>
    <auth.realm>qaa-realm</auth.realm>
    <auth.role.provider>provider</auth.role.provider>
    <auth.role.user>user</auth.role.user>
    <auth.clientId>qaa-client</auth.clientId>
    <auth.clientSecret>qaa-secret</auth.clientSecret>
    <auth.theme>qaa-theme</auth.theme>
    <auth.accessToken.timeout>5</auth.accessToken.timeout>
    <auth.refreshToken.cookie.timeout>10</auth.refreshToken.cookie.timeout>

    <exec-plugin.version>3.2.0</exec-plugin.version>

    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <modules>
    <module>container</module>
    <module>e2etest</module>
    <module>keycloak-refimpl</module>
    <module>svelte-refimpl</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <version>1.2.1</version>
        <executions>
          <execution>
            <id>load-env-properties</id>
            <phase>initialize</phase>
            <goals>
              <goal>read-project-properties</goal>
            </goals>
            <configuration>
              <quiet>true</quiet>
              <files>
                <file>${maven.multiModuleProjectDirectory}/refimpl/env.properties</file>
              </files>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>e2etest</id>
      <activation>
        <property>
          <name>env.E2E_TEST</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <auth.accessToken.timeout>1</auth.accessToken.timeout>
        <auth.refreshToken.cookie.timeout>2</auth.refreshToken.cookie.timeout>
      </properties>
    </profile>

    <profile>
      <id>generate-env-properties</id>
      <activation>
        <file>
          <missing>env.properties</missing>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>reserve-ports</id>
                <inherited>false</inherited>
                <phase>initialize</phase>
                <goals>
                  <goal>reserve-network-port</goal>
                </goals>
                <configuration>
                  <portNames>
                    <portName>auth.port</portName>
                    <portName>auth.port.ssl</portName>
                    <portName>backend.port</portName>
                    <portName>frontend.port</portName>
                    <portName>smtp.web.port</portName>
                  </portNames>
                  <outputFile>${maven.multiModuleProjectDirectory}/refimpl/env.properties</outputFile>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
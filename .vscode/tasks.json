{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-containers",
      "type": "shell",
      "osx": {
        "command": "./mvnw"
      },
      "windows": {
        "command": ".\\mvnw"
      },
      "linux": {
        "command": "./mvnw"
      },
      "args": ["-pl", "refimpl/container", "-am", "compile"],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "start-backend",
      "type": "shell",
      "osx": {
        "command": "./mvnw"
      },
      "windows": {
        "command": ".\\mvnw"
      },
      "linux": {
        "command": "./mvnw"
      },
      "args": ["-pl", "refimpl/keycloak-refimpl", "-am", "quarkus:dev"],
      "problemMatcher": []
    }
  ]
}
